# ============================================================
# admin-panel/instance/admin.env.example
# ============================================================
# Archivo de configuracion del admin panel
# COPIAR este archivo como admin.env y editar valores:
#   cp admin.env.example admin.env
#   nano admin.env
#
# NUNCA commitear admin.env a git
# ============================================================

JITSI_ADMIN_PASSWORD_HASH=REEMPLAZA_CON_SHA256_HEX_DE_64_CHARS
FLASK_SECRET_KEY=REEMPLAZA_CON_HEX_ALEATORIO_DE_64_CHARS

# ------------------------------------------------------------
# Fase 2 - JWT y moderacion A/V (todas OPCIONALES)
# ------------------------------------------------------------
# El panel lee JWT_APP_ID, JWT_APP_SECRET, JWT_ACCEPTED_ISSUERS y
# JWT_ACCEPTED_AUDIENCES del .env de Jitsi (/opt/jitsi-meet/.env), los
# MISMOS valores que usa Prosody: asi iss/aud siempre coinciden.
# Firma iss = primer valor de JWT_ACCEPTED_ISSUERS (o JWT_APP_ID si no hay)
# y aud = primer valor de JWT_ACCEPTED_AUDIENCES (o JWT_APP_ID).
#
# Solo para casos especiales: forzar iss/aud. Si no coinciden con lo que
# Prosody acepta, el panel lo avisa en el log y en /admin, y Jitsi
# rechazara todos los tokens. Normalmente: NO definir.
# JWT_ISSUER=cerroazul-panel
# JWT_AUDIENCE=cerroazul
#
# Minutos despues del fin previsto (fecha + duracion) en que vence el token.
# Pasado ese momento /unirse responde "Reunion finalizada".
# JWT_EXP_MARGIN_MIN=30
#
# Prefijo de las salas nuevas (seguido de 16 hex aleatorios).
# SALA_PREFIX=asamblea-
#
# Nombre visible del administrador dentro de Jitsi.
# ADMIN_DISPLAY_NAME=Administracion
