# Archivos con secretos - NUNCA commitear
.env
.env.local
*.env.local

# Admin panel secrets
admin-panel/instance/admin.env
admin-panel/instance/*.db
admin-panel/instance/*.log
admin-panel/instance/reuniones.db
admin-panel/instance/app.log

# Backups
*.bak
*.bak.*
*.backup
*~

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/

# Docker
docker-compose.override.yml

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo

# Node (por si acaso)
node_modules/

# Archivos temporales
*.tmp
*.bak.1788*
*.bak.1789*

# Config generada por el entrypoint de jitsi/web en cada arranque.
# Solo se versionan los custom-*.js de la Fase 3 (sala grande).
web/config/*
!web/config/custom-config.js
!web/config/custom-interface_config.js

# Respaldos de scripts/backup.sh (BACKUP_DIR por defecto cae dentro del
# despliegue: /opt/jitsi-meet/backups) y copias previas de restore.sh.
# Llevan secretos (cifrados o no): NUNCA al repo.
backups/
cerroazul-backup-*.tar.gz
.pre-restore-*/

# Certificados del TURN (la clave privada nunca al repo)
turn/certs/

# Informes y tokens de la prueba de carga
loadtest/results/
loadtest/*.jwt

# --- Copia de seguridad en Drive (Fase 10) ------------------------------
# La clave con la que se cifra el paquete de secretos NUNCA al repo.
# Vive en /root/.cerro-azul-backup/CLAVE.txt.
CLAVE.txt
*.clave
backup-*.tar.gz
backup-*.tar.gz.enc
secretos-*.tar.gz
secretos-*.tar.gz.enc
*.bundle


# --- Respaldo de migracion (scripts/backup-proyecto.sh) ----------------
# El paquete lleva secretos (cifrados) y la passphrase vive en
# /root/.backup-proyecto-passphrase: ninguno de los dos va al repo.
cerro-azul-jitsi-*.tar.gz
cerro-azul-jitsi-*.tar.gz.sha256
*passphrase*
!docs/*passphrase*
