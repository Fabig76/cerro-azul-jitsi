# ============================================================
# Jitsi Meet - Cerro Azul - .env.example
# ============================================================
# 
# INSTRUCCIONES:
# 1. Copiar este archivo: cp .env.example .env
# 2. Generar passwords con: ./gen-passwords.sh > .env (solo las lineas nuevas)
# 3. Editar .env y reemplazar los valores CAMBIAR-... con los valores reales
# 4. NUNCA commitear .env a git (esta en .gitignore)
#
# Para generar passwords automaticamente:
#   ./gen-passwords.sh
#
# ============================================================

# ==========================================================
# Jitsi Meet - Cerro Azul Reuniones
# Regenerado: 2026-09-08
# Dominio: meet.urbcerroazul.com
# ==========================================================

# --- Publico ---
PUBLIC_URL=meet.tu-dominio.com
TZ=America/Bogota

# --- Auth Prosody (componentes internos) ---
JICOFO_AUTH_PASSWORD=CAMBIAR-con-output-de-gen-passwords.sh
JVB_AUTH_PASSWORD=CAMBIAR-con-output-de-gen-passwords.sh

# --- JWT (admin panel firma tokens) ---
JWT_APP_ID=jitsi-admin-panel
JWT_APP_SECRET=CAMBIAR-con-output-de-gen-passwords.sh

# --- Limites (max 200 participantes) ---
MAX_PARTICIPANTS=200
MAX_BRIDGE_PARTICIPANTS=200
VISITORS_MAX_PARTICIPANTS=200

# --- Auth DESHABILITADA (participantes entran sin login) ---
# Los participantes NO ven modal de login.
# El control de acceso se hace via JWT firmado por el admin panel
# que se valida en Prosody con token_verification.
ENABLE_AUTH=0
AUTH_TYPE=anonymous

# --- XMPP ---
XMPP_DOMAIN=meet.urbcerroazul.com
XMPP_AUTH_DOMAIN=auth.meet.urbcerroazul.com
XMPP_MUC_DOMAIN=muc.meet.urbcerroazul.com
XMPP_INTERNAL_MUC_DOMAIN=internal-muc.meet.urbcerroazul.com
XMPP_SERVER=prosody
XMPP_BOSH_URL_BASE=http://prosody:5280

# --- JVB ---
JVB_XMPP_SERVER=jvb
JVB_XMPP_PORT=5347
JVB_BREWERY_MUC=jvbbrewery
JVB_PORT_10000=10000

# --- Recorder / brewery (no usamos pero Jicofo los pide) ---
XMPP_RECORDER_DOMAIN=recorder.meet.urbcerroazul.com
JIBRI_BREWERY_MUC=jibribrewery
JIGASI_BREWERY_MUC=jigasibrewery
ENABLE_RECORDING=0
ENABLE_JIBRI=0
ENABLE_OCTO=0
ENABLE_VISITORS=0
ENABLE_SCTP=1

# --- Jicofo (sin auth, max 200, jwt validation via prosody) ---
JICOFO_AUTH_LIFETIME=60
JICOFO_ENABLE_AUTH=0
JICOFO_AUTH_TYPE=jwt

# --- Admin panel ---
ADMIN_JWT_SECRET=CAMBIAR-cualquier-hex-64-chars

JVB_PUBLIC_ADDRESS=IP-PUBLICA-DEL-VPS
COLIBRI_REST_ENABLED=true
JVB_ADVERTISE_IPS=IP-PUBLICA-DEL-VPS

# Deshabilitar AwsCandidateHarvester (fix issue #2008 - evita cuelgues del JVB)
DISABLE_AWS_HARVESTER=true

# TURN server (external_services) - nomenclatura correcta docker-jitsi-meet
TURN_CREDENTIALS=CAMBIAR-secret-32-bytes-hex
TURN_HOST=meet.tu-dominio.com
TURN_PORT=443
TURN_TRANSPORT=tcp
