# ============================================================
# Jitsi Meet - Cerro Azul - .env.example
#
# INSTRUCCIONES:
#   1. cp .env.example .env
#   2. ./gen-passwords.sh            (genera los 5 secretos, imprime KEY=valor)
#   3. Pegar esos valores aqui, o:  ./gen-passwords.sh >> .env
#   4. Reemplazar los valores de ejemplo (TU-DOMINIO, IP-PUBLICA) por los reales
#   5. NUNCA commitear .env (esta en .gitignore)
#
# Verificacion:  ./scripts/validate-env.sh
# ============================================================

# ==========================================================
# Version de las imagenes Jitsi (una sola vez para los 4 servicios)
# Fijada a una version exacta, nunca 'stable' ni 'latest'.
# stable-11031 = JVB 2.3.295 (DTLS 1.3 + fix AWS harvester)
# ==========================================================
JITSI_IMAGE_VERSION=stable-11031

# --- Publico ---
PUBLIC_URL=meet.TU-DOMINIO.com
TZ=America/Bogota

# --- Auth Prosody (componentes internos) ---
# Secretos generados por gen-passwords.sh (32 hex cada uno)
JICOFO_AUTH_PASSWORD=CAMBIAR-con-gen-passwords.sh
JVB_AUTH_PASSWORD=CAMBIAR-con-gen-passwords.sh

# --- JWT (el admin panel firma los tokens de acceso a las salas) ---
# JWT_APP_ID: Prosody lo renderiza como app_id. Si JWT_ACCEPTED_ISSUERS
# no estuviera definido, Prosody aceptaria SOLO iss == JWT_APP_ID.
JWT_APP_ID=cerroazul
# Clave HS256 compartida panel <-> Prosody (64 hex).
JWT_APP_SECRET=CAMBIAR-con-gen-passwords.sh
# Secretos del panel (64 hex). Distinto del JWT_APP_SECRET.
ADMIN_JWT_SECRET=CAMBIAR-con-gen-passwords.sh
# Prosody rechaza el token si su 'iss' no esta en esta lista (lista
# separada por comas). El panel firma con el PRIMER valor.
JWT_ACCEPTED_ISSUERS=cerroazul-panel
# Igual para 'aud'. El panel firma con el PRIMER valor.
JWT_ACCEPTED_AUDIENCES=cerroazul
# 0 = sin token NO se entra. 1 abriria las salas a cualquiera.
JWT_ALLOW_EMPTY=0
# 0 = el claim 'sub' NO se compara con el dominio. El panel pone en 'sub'
# un id unico por participante; si se activa la verificacion de dominio,
# 'sub' tendria que ser el dominio y los tokens actuales serian rechazados.
JWT_ENABLE_DOMAIN_VERIFICATION=0

# --- Limites de participantes ---
# El objetivo es una asamblea de 500 personas, asi que los limites van a 500.
#
# Donde vive cada limite (verificado en las plantillas stable-11031):
#   MAX_PARTICIPANTS          -> Prosody: muc_max_occupants en el MUC de
#                                conferencias (y en el de breakout).
#                                Jicofo NO lo lee en esta version.
#   MAX_BRIDGE_PARTICIPANTS   -> Jicofo: max-bridge-participants (por JVB).
#   VISITORS_MAX_PARTICIPANTS -> Jicofo: solo con ENABLE_VISITORS=1 (aqui 0).
# El web no lee ninguno de los tres.
#
# IMPORTANTE: quitar la variable NO la desactiva. Sin MAX_PARTICIPANTS la
# plantilla no renderiza muc_max_occupants y Prosody aplica su valor por
# defecto, que es 200 (verificado renderizando la plantilla con y sin la
# variable). Para subir el limite hay que FIJARLA en 500, no borrarla.
#
# El valor real depende de la capacidad del servidor (Fase 5, pruebas de
# carga): un maximo aqui hace que Jitsi rechace participantes EN SILENCIO
# al llegar a ese numero.
MAX_PARTICIPANTS=500
MAX_BRIDGE_PARTICIPANTS=500
#VISITORS_MAX_PARTICIPANTS=500

# --- Sala grande (Fase 3) ---
# Las lee la plantilla settings-config.js de jitsi/web. Ademas
# web/config/custom-config.js fija lo mismo en el cliente (doble capa).
# 0 = sin salas de breakout (oculta "Anadir sala"). A 500 personas cada
# sala de breakout es otra conferencia que Jicofo/JVB tienen que sostener.
ENABLE_BREAKOUT_ROOMS=0
# 0 = sin pantalla previa. Con JWT el nombre viene del token, y la prejoin
# permitiria encender micro/camara antes de que la moderacion este activa.
ENABLE_PREJOIN_PAGE=0
# 0 = sin P2P. En P2P el medio no pasa por el JVB (y con 2 personas
# Jitsi lo usa por defecto); al entrar el tercero hay renegociacion.
ENABLE_P2P=0

# --- Auth (Fase 2: JWT obligatorio) ---
# ATENCION: ENABLE_AUTH=1 + JWT_ALLOW_EMPTY=0 => SIN TOKEN NO ENTRA NADIE.
# Rollback (salas abiertas como en Fase 1):
#   ENABLE_AUTH=0, PROSODY_AUTH_TYPE=anonymous, AUTH_TYPE=anonymous
# y recrear prosody/web/jicofo. Ver README "Fase 2".
ENABLE_AUTH=1
# La variable que decide el modulo de autenticacion de Prosody es
# PROSODY_AUTH_TYPE. AUTH_TYPE solo es su fallback (la plantilla hace
# PROSODY_AUTH_TYPE | default AUTH_TYPE). Se definen las dos iguales para
# que web/jicofo (que leen AUTH_TYPE) no queden incoherentes.
PROSODY_AUTH_TYPE=jwt
AUTH_TYPE=jwt
# Sin dominio de invitados: nadie entra como anonimo.
ENABLE_GUESTS=0
# Sin sala de espera: el control de acceso es el JWT.
ENABLE_LOBBY=0
# Moderacion de audio/video (mod_av_moderation). El moderador la activa
# en la reunion y aprueba a quien puede hablar / encender camara.
ENABLE_AV_MODERATION=1
# Modulos extra para el componente MUC (conference). OJO con el nombre:
#   XMPP_MODULES     -> se cargan en el VirtualHost principal.
#   XMPP_MUC_MODULES -> se cargan en el Component "muc".
# token_affiliation engancha 'muc-occupant-pre-join', evento que SOLO
# dispara en el componente MUC: en XMPP_MODULES se cargaria sin efecto
# y nadie seria moderador por token. Verificado en la plantilla
# /defaults/conf.d/jitsi-meet.cfg.lua de jitsi/prosody:stable-11031.
XMPP_MUC_MODULES=token_affiliation
# Todos entran con mic y camara apagados (config.startWithAudioMuted /
# startWithVideoMuted, plantilla settings-config.js de jitsi/web).
START_WITH_AUDIO_MUTED=1
START_WITH_VIDEO_MUTED=1

# --- XMPP ---
XMPP_DOMAIN=meet.TU-DOMINIO.com
XMPP_AUTH_DOMAIN=auth.meet.TU-DOMINIO.com
XMPP_MUC_DOMAIN=muc.meet.TU-DOMINIO.com
XMPP_INTERNAL_MUC_DOMAIN=internal-muc.meet.TU-DOMINIO.com
XMPP_SERVER=prosody
XMPP_BOSH_URL_BASE=http://prosody:5280

# --- JVB (videobridge) ---
JVB_XMPP_SERVER=jvb
JVB_XMPP_PORT=5347
# Debe ser SOLO el nombre del MUC ('jvbbrewery'), NO el dominio completo.
# Si se pone el dominio completo, el JVB entra al MUC equivocado y
# Jicofo reporta "no operational bridges".
JVB_BREWERY_MUC=jvbbrewery
JVB_PORT_10000=10000
# IP publica del VPS. El JVB la anuncia en sus candidatos ICE.
JVB_ADVERTISE_IPS=IP-PUBLICA-DEL-VPS
# NO definas LOCAL_ADDRESS: el entrypoint de la imagen lo autodetecta
# (export LOCAL_ADDRESS=$(ip route get 1 ...)) y pisa la variable.
# Definirla a mano solo produce drift cuando cambia la IP del contenedor.
# NO definas JVB_PUBLIC_ADDRESS: esta obsoleta; el entrypoint la migra a
# JVB_ADVERTISE_IPS y avisa por log.
# Sin esto, /about/health devuelve 404 y Jicofo marca el bridge como
# no operacional aunque todo lo demas parezca bien.
COLIBRI_REST_ENABLED=true
# El JVB cuelga sin esto (issue upstream #2008).
DISABLE_AWS_HARVESTER=true
# Dominio que anuncia el JVB para su websocket Colibri.
JVB_WS_DOMAIN=meet.TU-DOMINIO.com

# --- Recorder / brewery (no se usan, pero Jicofo los consulta) ---
XMPP_RECORDER_DOMAIN=recorder.meet.TU-DOMINIO.com
JIBRI_BREWERY_MUC=jibribrewery
JIGASI_BREWERY_MUC=jigasibrewery
ENABLE_RECORDING=0
ENABLE_JIBRI=0
ENABLE_OCTO=0
ENABLE_VISITORS=0
ENABLE_SCTP=1

# --- Jicofo ---
JICOFO_AUTH_LIFETIME=60
# 0 a proposito: con autenticacion de Jicofo tipo JWT, Jicofo da owner a
# TODO usuario autenticado (todos vienen con JWT) => todos moderadores.
# El rol lo decide token_affiliation en Prosody segun context.user.moderator.
# Se fija explicito porque el default de JICOFO_ENABLE_AUTH es ENABLE_AUTH (=1).
JICOFO_ENABLE_AUTH=0
JICOFO_AUTH_TYPE=jwt
# false = Jicofo NO convierte en moderador al primero que entra (default
# de Jicofo: true). Sin esto el primer asistente seria moderador.
ENABLE_AUTO_OWNER=false

# --- TURN ---
# Secreto compartido para firmar credenciales TURN de corta duracion.
# Generado por gen-passwords.sh (32 hex).
#
# IMPORTANTE: hoy NO hay servidor TURN (coturn) en este stack, asi que
# este valor no esta en el camino del audio/video real (que va por el JVB
# en UDP 10000). Se usara cuando se despliegue coturn (Fase 4 del plan).
TURN_CREDENTIALS=CAMBIAR-con-gen-passwords.sh
TURN_HOST=meet.TU-DOMINIO.com
TURN_PORT=443
TURN_TRANSPORT=tcp
# STUN: el JVB lo usa para descubrir su IP publica.
STUN_HOST=stun.l.google.com
STUN_PORT=19302
